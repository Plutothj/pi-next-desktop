{
  "name": "pi-desktop",
  "version": "0.2.58",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-force-exit \"tests/*.test.mjs\"",
    "stage": "node scripts/stage-runtime.mjs",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "dist": "npm run stage && npm run build && electron-builder --publish never",
    "dist:dir": "npm run stage && npm run build && electron-builder --dir",
    "release": "npm run stage && npm run build && electron-builder --publish always",
    "lint": "biome lint src electron tests",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "marked": "^16.4.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/mermaid": "^1.0.3",
    "adm-zip": "^0.6.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "ai": "^7.0.159",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
    "driver.js": "^1.10.2",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "motion": "^14.9.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.5.438",
    "pi-mobile": "^0.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "use-stick-to-bottom": "^1.1.6",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "dev.pi.desktop",
    "productName": "Pi",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "runtime/deps",
        "to": "runtime/node_modules"
      },
      {
        "from": "build/icon.png",
        "to": "pi.png"
      },
      {
        "from": "build/icon.ico",
        "to": "pi.ico"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Plutothj",
      "repo": "pi-next-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "pi coding agent 的桌面客户端",
  "author": {
    "name": "Plutothj"
  }
}

{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "stage": "node scripts/stage-runtime.mjs",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "dist": "npm run stage && npm run build && electron-builder",
    "dist:dir": "npm run stage && npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "marked": "^16.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/mermaid": "^1.0.3",
    "ai": "^7.0.159",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "diff": "^8.0.4",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "build": {
    "appId": "dev.pi.desktop",
    "productName": "Pi",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools"
    },
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    }
  }
}